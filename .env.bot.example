# Bot 独立配置模板
#
# 复制为 .env.bot 后填写。运行 run_stage3.bat / run_stage3.sh 时会自动使用它，
# 于是 Bot 和你的日常对话可以用**不同的 API Key**，账单天然分开。
#
# 关键点：`QQBOT_ENV_FILE=.env.bot` 是**整体替换** .env，不是合并。
# 两份文件不会互相渗透，所以这里必须写全 Bot 需要的全部配置。
# 别只写 API Key 就完事——那样其他配置会退回代码默认值。
#
# `.env.bot` 已被 .gitignore 忽略，绝不会被提交。

# === 模型服务商：换成 Bot 专用账户的 Key ===
QQBOT_API_BASE_URL=https://api.deepseek.com
QQBOT_API_MODEL=deepseek-chat
# 回复 agent 用的 key
QQBOT_API_KEY=replace-with-bot-account-key
# 可选：判定 / 记忆维护各用一把（不配就回落上面的主 key）。
# 注意：**同一个账号下的多把 key 不隔离并发限额与缓存容量**——那两样是账号级的，
# KVCache 隔离靠请求里的 user_id。分 key 的意义是"出问题只吊销那一把"；
# 若三个 key 属于三个账号，配额与账单才是真的分开。
# QQBOT_JUDGE_API_KEY=replace-with-judge-key
# QQBOT_MEMORY_API_KEY=replace-with-memory-key

# === 长期记忆 ===
QQBOT_MEMORY_ENABLED=1
QQBOT_MEMORY_INTERVAL_SECONDS=600
QQBOT_MEMORY_RETENTION_DAYS=7
# QQBOT_MEMORY_MODEL 默认复用 QQBOT_API_MODEL

# === OneBot / NapCat ===
# Bot 监听，NapCat 作为 wsClient 连进来
ONEBOT_WS_HOST=127.0.0.1
ONEBOT_WS_PORT=8080
ONEBOT_ACCESS_TOKEN=

# 掉线事件：一次掉线只广播一次（掉线期间反复检查不再通知），恢复不发；
# 重连后重新武装，再次断开算新的一段。谁来接是插件的事；0 = 关掉广播。
QQBOT_DISCONNECT_NOTICE=1

# SnowLuma 侧只读接口与 WS 地址
QQBOT_SNOWLUMA_HTTP_BASE_URL=http://127.0.0.1:3000
QQBOT_SNOWLUMA_WS_URL=ws://127.0.0.1:3001
QQBOT_SNOWLUMA_ACCESS_TOKEN=

# === 双 agent（判定 / 回复分离）===
# 1 = 判定 agent 先决定要不要接，不接就不发生回复调用（默认开）
QQBOT_DUAL_AGENT=1
# 判定可以用更便宜/更快的模型；不写则复用 QQBOT_API_MODEL
# QQBOT_JUDGE_MODEL=deepseek-chat
# 同一账号下按用途隔离缓存与调度（与 API Key 无关，不要填中文或空格）
QQBOT_DIALOGUE_USER_ID=qqbot-dialogue
QQBOT_JUDGE_USER_ID=qqbot-judge
QQBOT_MEMORY_USER_ID=qqbot-memory

# === 多群焦点（规则见 docs/MULTI_GROUP_FOCUS.md）===
# 话题 45 秒没有继续就释放当值；当值上限 5 分钟；连回 50 条交代一句再走；
# 同一群里"稍等"的冷却 120 秒。一般不用改。
QQBOT_FOCUS_QUIET_SECONDS=45
QQBOT_FOCUS_DUTY_SECONDS=300
QQBOT_FOCUS_REPLY_LIMIT=50
QQBOT_FOCUS_ACK_COOLDOWN_SECONDS=120

# === 行为开关 ===
# 群聊里每条消息都进模型判断（0 = 退回旧的锁焦行为）
QQBOT_GROUP_LISTEN=1
# 拟人化节奏：分段输出 + 打字停顿（0 = 立刻发）
QQBOT_TYPING_SIM=1

# === 余额命令 /balance ===
# 读的是账号资金信息，默认仅超管私聊可用（fail-closed）。换到 Bot 账户后，
# 这个命令显示的会是 **Bot 账户**的余额。
# QQBOT_BALANCE_PRIVATE_USER_IDS=900000001
# QQBOT_BALANCE_GROUP_IDS=
QQBOT_BALANCE_CACHE_SECONDS=60

# === 运行数据 ===
# QQBOT_DATA_DIR 默认是项目下的 data/
# QQBOT_STATE_PERSIST=0 可关闭运行状态持久化
# QQBOT_STATE_FILE 可指定 runtime_state.json 的完整路径

# === 调试（生产环境建议全部注释掉）===
# QQBOT_DEBUG_MODEL_IO=1
# QQBOT_DEBUG_MODEL_IO_FILE=data/traces/model_trace.jsonl
