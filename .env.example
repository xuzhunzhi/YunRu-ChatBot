# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，绝不要提交。
# 真实环境变量优先于本文件；本文件优先于代码内默认值。
#
# 想让 Bot 用**独立账户**（账单与日常对话分开）：
#   1. 复制 .env.bot.example 为 .env.bot，填入 Bot 专用 Key；
#   2. 用 run_stage3.bat / run_stage3.sh 启动 —— 它们会自动使用 .env.bot。
# `QQBOT_ENV_FILE` 是**整体替换** .env（不合并），同名键由哪份生效一眼可知。
# 直接 `python -m qq_roleplay_bot.stage3_main` 启动不会走 .env.bot，会仍用 .env。

QQBOT_API_BASE_URL=https://api.deepseek.com
# 模型名写**真名**：deepseek 侧现在是 `deepseek-flash`（`deepseek-chat` 是会消失的别名）。
QQBOT_API_MODEL=deepseek-flash
QQBOT_API_KEY=replace-me
# **那把主 key 属于哪一家**（可选但**强烈建议**）。
# 2026-10-06 配置层重做成 providers / keys / tasks 三层：一个客户端的三件套
# （地址 / key / 模型名）**永远由同一条 key 条目解析出来**，所以"A 家 key 打 B 家地址"
# 写不出来。上面两行是**兼容档**（历史部署的默认值）；写了这一行等于说清
# "那把 key 是哪家的"，地址与供应商都按它算。不写也能跑（只配一把 key 的部署照旧），
# 但启动自检里会显示 `兼容档·未声明，按<本用途自带那家>算`。
# QQBOT_API_PROVIDER=deepseek
# 可选：**只给回复 agent** 的一套地址 / 模型 / key（2026-10-05 起可以有）；
# 不配就是上面的全局那一套。
# QQBOT_REPLY_API_BASE_URL=https://api.example.com/v1
# QQBOT_REPLY_API_MODEL=replace-with-reply-model
# QQBOT_REPLY_API_KEY=replace-with-reply-key

# --- 每个用途各自一把 key（**推荐**：各绑各家，互不串味）---
# 判定 / 记忆 / 风格审核 / 识图 走 deepseek；回复 / 写信（长文）走 mimo。
# 不配某一项时会回落：letter → reply 那把；judge/memory/review/vision → judge 那把；
# 最后才回落兼容档（`QQBOT_API_KEY`）。**回落项都同家**，所以不会串成"A 家 key 打 B 家"。
# QQBOT_JUDGE_API_KEY=
# QQBOT_MEMORY_API_KEY=
# QQBOT_REVIEW_API_KEY=
# QQBOT_VISION_API_KEY=
# QQBOT_LETTER_API_KEY=
# 写信（长文）用哪个模型；默认 mimo-v2.6-pro（用户："长文用 mimo pro 吧"）
# QQBOT_LETTER_API_MODEL=
# 各用途的地址覆盖（一般不用写；写了就是"这条 key 打这个地址"）
# QQBOT_JUDGE_API_BASE_URL=
# QQBOT_MEMORY_API_BASE_URL=
# QQBOT_REVIEW_API_BASE_URL=
# QQBOT_VISION_API_BASE_URL=
# QQBOT_LETTER_API_BASE_URL=

# 长期记忆
QQBOT_MEMORY_ENABLED=1
QQBOT_MEMORY_INTERVAL_SECONDS=600
QQBOT_MEMORY_RETENTION_DAYS=7
# QQBOT_MEMORY_MODEL 默认复用 QQBOT_API_MODEL

# 运行数据与运行状态
# QQBOT_DATA_DIR 默认是项目下的 data/
# QQBOT_STATE_PERSIST=0 可关闭运行状态持久化
# QQBOT_STATE_FILE 可指定 runtime_state.json 的完整路径

# NapCat / OneBot（Stage 3 反向 WS：Bot 监听，NapCat 连进来）
# 注意：Stage 3 的入口只构造传输层；装配与主循环在 runtime.serve 里，与通道无关。
# Stage 4 会用同一套 serve()，换成 OneBotClientTransport 去连 QQBOT_SNOWLUMA_WS_URL。
ONEBOT_WS_HOST=127.0.0.1
ONEBOT_WS_PORT=8080
ONEBOT_ACCESS_TOKEN=

# 掉线事件（掉线通知那类插件用它）
# 看门狗每 60 秒查一次"对面还连着没有"（检测节奏；那条告警日志仍是 10 分钟一条），
# 这里把那个状态变成确定的边沿：
# **在线 → 掉线** 广播一次（最多晚一个检测周期，即 ≤60 秒），掉线期间反复检查
# 不再通知，重连后重新武装、再次断开才算新的一段（**恢复不发**）。
# 开机时对面一直没连上也算一段（那种"机器起来、谁也看不见"正是要通知的故障）。
# 本体只广播"断了"这个事实，谁来接是插件的事；0 = 一次都不广播。
QQBOT_DISCONNECT_NOTICE=1

# 群聊注意力
# 1（默认）= 群里每条消息都送进模型判断，她能看见别人之间的对话，自己决定接不接。
# 0         = 旧行为：只跟当前对话对象说话，别人的发言只当背景，不进模型。
# 打开会增加模型调用次数（换来的是她在群里不像在私聊）。私聊不受影响。
QQBOT_GROUP_LISTEN=1

# 拟人化节奏
# 1（默认）= 回复不再秒回：先亮"正在输入"，按字符数估算打字时间；
#            正文里的空行会被拆成"连着发的几条"分别送出。
# 0         = 模型一返回就立刻发，且整段一次发出（旧行为）。
# 命令类回复（ping / help 等）始终不延迟。
QQBOT_TYPING_SIM=1

# 调试：把模型原始输入输出落盘（含完整 system prompt 与聊天正文，仅调试期使用）
# 路径刻意放在 data/ 下而不是 .tmp_test_run/：后者是测试产物目录，
# 追踪文件曾经在那里丢过一次（原因未查明）。data/ 已在 .gitignore 里。
# QQBOT_DEBUG_MODEL_IO=1
# QQBOT_DEBUG_MODEL_IO_FILE=data/traces/model_trace.jsonl

# --- WebUI 面板（Stage 4 后台插件，见 docs/WEBUI.md）---
# 面板跑在 bot 进程里，权限与超管一致（除不能改代码），所以**默认只绑本机**。
# local：用 data/webui_token（留空则首次启动自动生成）。remote：用口令换会话 cookie。
# QQBOT_WEBUI=1                       # 0 关掉整块（不装配、不占端口）
# QQBOT_WEBUI_ACCESS_MODE=local       # local | remote
# QQBOT_WEBUI_PORT=8790
# QQBOT_WEBUI_HOST=127.0.0.1          # 仅 remote 模式生效
# QQBOT_WEBUI_TOKEN=                  # local：留空 = 自动生成 data/webui_token
# QQBOT_WEBUI_PASSWORD=               # remote：至少 8 位；只存哈希到 data/webui_password
# QQBOT_WEBUI_ALLOWED_ORIGINS=        # remote：逗号分隔，默认取监听地址本身
# QQBOT_WEBUI_BEHIND_PROXY=0          # remote：置 1 才信任 X-Forwarded-For（用于记真实来源）

# 余额查询命令 /balance
# 读的是账号资金信息，所以**默认只在超管私聊可用**（fail-closed：不配就查不到）。
# 要放开到群，必须显式写群号——控制群默认就是被启用的测试群，里面有别人。
# QQBOT_BALANCE_PRIVATE_USER_IDS=900000001   # 不写则取 SUPER_ADMIN_USER_IDS
# QQBOT_PRIVATE_DEBUG_USER_IDS=900000001    # 谁能在私聊里和 Bot 说话（不写则取 SUPER_ADMIN_USER_IDS）

# --- 每日汇报（Stage 4：Agent Mail）---
# QQBOT_MAIL_REPORT=1                        # 0 关掉整条路径
# QQBOT_MAIL_REPORT_AT=23:00                 # 每晚几点发（本地时间）
# QQBOT_MAIL_REPORT_TO=xuzhunzhi@foxmail.com # 收件人常量，不从对话里取
# QQBOT_MAIL_CLI=agently-cli                 # CLI 名字（换机器时改这里）
# QQBOT_MAIL_REPORT_MAX_CHARS=1500
# QQBOT_MAIL_REPORT_MAX_TRIES=3
# QQBOT_BALANCE_GROUP_IDS=                    # 逗号分隔；留空即群聊不可用
QQBOT_BALANCE_CACHE_SECONDS=60
